# Coze OAuth JWT 配置示例
# 复制此文件为 .env 并填入真实值

# OAuth 应用配置（必填）
COZE_JWT_OAUTH_CLIENT_ID=你的client_id
COZE_JWT_OAUTH_PUBLIC_KEY_ID=你的public_key_id

# 私钥配置（二选一）
# 方式1：直接配置私钥内容
COZE_JWT_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
你的私钥内容
-----END PRIVATE KEY-----"

# 方式2：使用私钥文件路径（如果使用此方式，注释掉上面的 PRIVATE_KEY）
# COZE_JWT_OAUTH_PRIVATE_KEY_FILE_PATH=./coze_private.pem

# Coze API 地址
COZE_API_BASE=https://api.coze.cn

# Bot ID（可选，默认值在 index.js 中）
COZE_BOT_ID=你的Bot ID

# Token 有效期（可选，默认 3600 秒）
# COZE_ACCESS_TOKEN_TTL=3600

